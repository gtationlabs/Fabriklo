# =============================================================================
# Fabriklo environment variables. Copy to .env.local for development.
# NEVER commit real values. Production secrets live in the host's secret store.
# =============================================================================

# --- Public (safe in the browser; RLS is the security boundary) --------------
# Local values come from `npx supabase status` (these are the CLI's local defaults).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----------------------
# Used by trusted scripts (scripts/create-staff.ts) and, on the server only, by
# the payment/courier webhook handlers, the try-on and automation workers, and
# staff invitations / MFA resets (Auth admin API) (lib/supabase/service.ts). It is never
# sent to the browser and no page renders with it.
SUPABASE_SECRET_KEY=
# Direct DB URL for local tests only (never point at production).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Payments (slice 5) --------------------------------------------------------
# With both SSLCOMMERZ values set, online payment uses SSLCOMMERZ (sandbox unless
# SSLCOMMERZ_SANDBOX=false). With them empty, development/test runs use a clearly
# labelled MOCK gateway that moves no money; production offers COD only unless
# PAYMENTS_ALLOW_MOCK=true is set on purpose (never on a public store).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENTS_ALLOW_MOCK=

# --- Couriers (slice 5; webhooks only, adapters not verified against live APIs) -
# Each *_WEBHOOK_SECRET enables POST /api/couriers/<courier>/webhook (HMAC-SHA256
# over the raw body). Leave empty to keep the endpoint off (404).
PATHAO_WEBHOOK_SECRET=
STEADFAST_WEBHOOK_SECRET=
REDX_WEBHOOK_SECRET=
# API credentials for creating shipments/labels (not used yet):
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_API_TOKEN=

# --- AI try-on (slice 6) -------------------------------------------------------
# With FASHN_API_KEY set, try-on calls FASHN (api.fashn.ai, model tryon-v1.6).
# Without it, development/test builds use a clearly labelled DEMO MOCK that
# calls no provider; production hides the feature unless TRYON_ALLOW_MOCK=true
# (never on a public store). Quotas, the daily credit cap and retention are
# edited in Admin → AI try-on (stored in site_settings['tryon.limits']).
FASHN_API_KEY=
TRYON_ALLOW_MOCK=
# Enables POST /api/tryon/worker for a scheduler (every minute; Bearer token,
# 16+ chars). Jobs also start right after creation, so this covers retries,
# stragglers and purging expired photos.
TRYON_WORKER_SECRET=

# --- Bot protection / monitoring ----------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# --- Marketing, messaging and automation (slice 7) ----------------------------
# Email: an SMTP URL (smtp://user:pass@host:587 or smtps://…) + sender address.
# Without it, development/test builds use a labelled MOCK that delivers
# nothing (the outbox keeps a preview); production dead-letters email until
# SMTP is configured. NOTIFY_ALLOW_MOCK=true forces the mock (never on a live store).
SMTP_URL=
SMTP_FROM="Fabriklo <no-reply@example.com>"
NOTIFY_ALLOW_MOCK=
# SMS: generic HTTP gateway stub (POST JSON {to,text}, Bearer key). Adapt to
# the chosen Bangladesh gateway before go-live; untested against a real one.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# WhatsApp Business (Meta Cloud API) template messages; untested against a live account.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# HMAC-SHA256 key for outbound webhooks (X-Fabriklo-Signature). 32+ random chars.
WEBHOOK_SIGNING_SECRET=
# Derives stable unsubscribe tokens and hashes IPs in consent records (32+ random chars).
NOTIFY_TOKEN_SECRET=
# Enables POST /api/automation/worker for a scheduler (every 1–5 min; Bearer token, 16+ chars).
AUTOMATION_WORKER_SECRET=
# Analytics / ads tags: loaded only after cookie consent and only when set
# (the CSP is extended for them automatically).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Store name used in messages.
NEXT_PUBLIC_STORE_NAME=Fabriklo
