# =============================================================================
# Fabriklo environment variables. Copy to .env.local for development.
# NEVER commit real values. Production secrets live in the host's secret store.
# =============================================================================

# --- Public (safe in the browser; RLS is the security boundary) --------------
# Local values come from `npx supabase status` (these are the CLI's local defaults).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----------------------
# Used ONLY by trusted scripts/workers (e.g. scripts/create-staff.ts, reservation
# expiry worker). The Next.js request path does not use it.
SUPABASE_SECRET_KEY=
# Direct DB URL for local tests only (never point at production).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Payments (Phase 3) -------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- Couriers (Phase 3; only after account/API access is confirmed) ----------
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_API_TOKEN=

# --- AI try-on (Phase 5) -------------------------------------------------------
FASHN_API_KEY=
TRYON_DAILY_SPEND_CAP_USD=10

# --- Bot protection / monitoring ----------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# --- Messaging (Phase 6) --------------------------------------------------------
SMTP_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_ACCESS_TOKEN=
